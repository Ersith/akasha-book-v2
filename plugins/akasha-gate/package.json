{
  "name": "@akasha-book/gate",
  "version": "1.4.4",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "description": "阿卡夏之书门控：数据目录写入守卫（规则工厂 + ruleId + 试匹配同源）+ 系统提示注入来源态约定（akasha:protocol）+ 自我层（akasha:self，每会话自动核对「我是谁」）+ 自我行（akasha:self-line，每回合 runtime context，近场常驻——自我不是规则，不该靠提醒活着）",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "prompt-safety.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ersith/akasha-book.git",
    "directory": "plugins/akasha-gate"
  },
  "scripts": {
    "test": "node selftest.test.mjs",
    "check": "node --check index.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
